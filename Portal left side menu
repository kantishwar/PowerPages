<script>
  // JQuery to add the data timeout attribute to the popover to hide after a certain number of seconds
  $(document).ready(function () {
    debugger;
    

    $('[data-bs-toggle="popover"][data-timeout]').on('shown.bs.popover', function () {
      this_popover = $(this);
      setTimeout(function () {
        this_popover.popover('hide');
      }, $(this).data("timeout"));
    });


    //Enable popover everywhere
    let popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
    let popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
      return new bootstrap.Popover(popoverTriggerEl)
    });

    //Enable tooltips everywhere
    let tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    let tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl)
    });
  });

  //Get search box and cards into variables
  let searchInput = document.getElementById('HeaderSearchBox');
  //let searchInputSm = document.getElementById('HeaderSearchBoxSm');
  let cardsList = document.querySelectorAll('.tab-pane .row .col');

  //Function to loop through cards to check the value of string
  function getResults(e) {
    cardsList.forEach(val => {
      val.style.display = 'none';
      val.dataset.title.toLowerCase().includes(e.target.value.toLowerCase()) ?
        val.style.display = 'block' : null;
    })
  }
  //Call function on keyup event of the searchbox
  searchInput.addEventListener('keyup', getResults);
  //searchInputSm.addEventListener('keyup', getResults);
</script>
